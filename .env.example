# TMDb v3 API key (https://www.themoviedb.org/settings/api); injected as the api_key query parameter
TMDB_APIKEY=
# Plex server URL as reachable from this machine, e.g. http://plex.example:32400
PLEX_URL=
# Plex token (https://support.plex.tv/articles/204059436); injected as the X-Plex-Token header
PLEX_TOKEN=
